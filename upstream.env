# Reviewed upstream pin. Bump only after reviewing the diff (docs/pin-bump.md).
# UPSTREAM_TAG must resolve to UPSTREAM_REF; the build refuses otherwise.
UPSTREAM_REPO=https://github.com/aaddrick/claude-desktop-debian.git
UPSTREAM_TAG=v3.3.18+claude6.28899.2
UPSTREAM_REF=f7dd9c8441f0da7b50e5ba4c713134eef1bdbb0b
# Upstream patches to omit at this pin (design D13). Space-separated
# active_patches names; the build fails if one isn't active.
# patch_tray_icon_env_override: anchor gone in .deb 6.28899.2 and .6
#   (upstream CI red on f7dd9c8 too). Only affects CLAUDE_TRAY_USE_DARK_ICON
#   (Cinnamon). Clear when a pin bump's tray-icon-selection.sh builds again.
UPSTREAM_SKIP_PATCHES="patch_tray_icon_env_override"
